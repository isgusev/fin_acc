# Скопируйте в .env и заполните. Файл .env в Git не попадает.
APP_ENV=development

# Локально: база из docker-compose (порт 5434)
DATABASE_URL=postgresql+psycopg://fin_acc:fin_acc@localhost:5434/fin_acc

# Случайная строка >= 32 символов. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# В production (HTTPS) обязательно true
COOKIE_SECURE=false
FORCE_HTTPS=false

# Первый администратор создаётся при старте, если администраторов ещё нет.
# После первого входа смените пароль и можете удалить эти переменные.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Для тестов (pytest)
TEST_DATABASE_URL=postgresql+psycopg://fin_acc:fin_acc@localhost:5434/fin_acc_test
